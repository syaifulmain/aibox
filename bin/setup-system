#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# AIBox System Setup — Installs & Configures Incus for Omarchy / Arch Linux
# Run once on a new machine before running './bin/install'
# ==============================================================================

TARGET_USER="${SUDO_USER:-$USER}"

echo "==> [1/6] Installing system packages (incus, dnsmasq, xorg-xhost, acl)..."
sudo pacman -S --needed --noconfirm incus dnsmasq xorg-xhost acl qt6-base qt6-declarative qt6-wayland

echo "==> [2/6] Configuring /etc/subuid and /etc/subgid..."
if ! grep -q "^root:" /etc/subuid 2>/dev/null; then
    echo "root:1000000:1000000000" | sudo tee -a /etc/subuid >/dev/null
fi
if ! grep -q "^root:" /etc/subgid 2>/dev/null; then
    echo "root:1000000:1000000000" | sudo tee -a /etc/subgid >/dev/null
fi

echo "==> [3/6] Adding user '$TARGET_USER' to incus-admin, kvm, render, and video groups..."
sudo usermod -aG incus-admin,kvm,render,video "$TARGET_USER"

echo "==> [4/6] Enabling Incus service & configuring socket ACL permissions..."
sudo systemctl enable --now incus.socket incus.service
sudo incus admin waitready --timeout=30

sudo mkdir -p /etc/systemd/system/incus.service.d
sudo tee /etc/systemd/system/incus.service.d/acl.conf >/dev/null << EOF
[Service]
ExecStartPost=/usr/bin/setfacl -m u:${TARGET_USER}:rw /var/lib/incus/unix.socket
EOF
sudo systemctl daemon-reload
sudo setfacl -m "u:${TARGET_USER}:rw" /var/lib/incus/unix.socket

echo "==> [5/6] Initializing Btrfs Storage Pool & Network Bridge (incusbr0)..."
if ! incus storage show default >/dev/null 2>&1; then
    cat << 'EOF' | sudo incus admin init --preseed
config: {}
networks:
- config:
    ipv4.address: auto
    ipv4.nat: "true"
    ipv6.address: none
  description: "Bridge network for AIBox"
  name: incusbr0
  type: bridge
  project: default
storage_pools:
- config: {}
  description: "Btrfs Storage Pool with disk quotas and instant snapshots"
  name: default
  driver: btrfs
profiles:
- config: {}
  description: "Default Incus profile"
  devices:
    eth0:
      name: eth0
      network: incusbr0
      type: nic
    root:
      path: /
      pool: default
      type: disk
  name: default
projects: []
cluster: null
EOF
fi

sudo btrfs quota enable /var/lib/incus/storage-pools/default 2>/dev/null || true

if ! incus profile show ai-gui >/dev/null 2>&1; then
    incus profile create ai-gui
fi
incus profile set ai-gui security.nesting=true
incus profile device remove ai-gui gpu >/dev/null 2>&1 || true
incus profile device add ai-gui gpu gpu mode=0666
incus profile device remove ai-gui kvm >/dev/null 2>&1 || true
incus profile device add ai-gui kvm unix-char source=/dev/kvm path=/dev/kvm mode=0666

echo "==> [6/6] Configuring UFW firewall rules for incusbr0..."
if systemctl is-active --quiet ufw; then
    sudo ufw allow in on incusbr0 comment 'Incus Bridge Input' >/dev/null || true
    sudo ufw route allow in on incusbr0 comment 'Incus Bridge Route In' >/dev/null || true
    sudo ufw route allow out on incusbr0 comment 'Incus Bridge Route Out' >/dev/null || true
fi

echo "==> System setup complete! Now run './bin/install' to build and install the AIBox desktop app."
