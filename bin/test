#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

find_cargo() {
    if cargo --version >/dev/null 2>&1; then
        command -v cargo
        return 0
    fi
    for candidate in /usr/bin/cargo "$HOME/.cargo/bin/cargo"; do
        if [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    echo "cargo not found (install rust or rustup)" >&2
    return 1
}

CARGO="$(find_cargo)"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"

MODE="full"
for arg in "$@"; do
    case "$arg" in
        --fast)
            MODE="fast"
            ;;
        --nextest)
            MODE="nextest"
            ;;
        *)
            echo "Unknown option: $arg (supported: --fast, --nextest)" >&2
            exit 2
            ;;
    esac
done

"$CARGO" fmt --all --check --manifest-path "$ROOT/rust/Cargo.toml"
"$CARGO" clippy --all-targets --manifest-path "$ROOT/rust/Cargo.toml" -- -D warnings

case "$MODE" in
    fast)
        "$CARGO" test --workspace --release --locked --lib --tests --manifest-path "$ROOT/rust/Cargo.toml"
        ;;
    nextest)
        if "$CARGO" nextest --version >/dev/null 2>&1; then
            "$CARGO" nextest run --workspace --release --locked --manifest-path "$ROOT/rust/Cargo.toml"
            "$CARGO" test --doc --workspace --release --locked --manifest-path "$ROOT/rust/Cargo.toml"
        else
            echo "cargo-nextest not installed; falling back to cargo test" >&2
            "$CARGO" test --workspace --release --locked --manifest-path "$ROOT/rust/Cargo.toml"
        fi
        ;;
    *)
        "$CARGO" test --workspace --release --locked --manifest-path "$ROOT/rust/Cargo.toml"
        ;;
esac
