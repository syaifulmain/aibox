#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

find_cargo() {
    if cargo --version >/dev/null 2>&1; then
        command -v cargo
        return 0
    fi
    for candidate in /usr/bin/cargo "$HOME/.cargo/bin/cargo"; do
        if [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    echo "cargo not found (install rust or rustup)" >&2
    return 1
}

CARGO="$(find_cargo)"
"$CARGO" test --release --locked --manifest-path "$ROOT/rust/Cargo.toml"
"$CARGO" build --release --locked --manifest-path "$ROOT/rust/Cargo.toml"

# P17c: C++ Backend and unused aibox-ffi bridges were deleted; tests/aibox_tests.cpp
# is retained until P18 ports the remaining Qt tests and adds the QML smoke test.
echo "Note: legacy C++ Qt test harness (tests/aibox_tests.cpp) is gated out after P17c removal of C++ Backend; P18 will replace it."
