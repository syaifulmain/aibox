#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# AIBox Clean Uninstaller
# Removes the AIBox desktop package (and optionally removes Incus & all data)
# ==============================================================================

echo "==> Removing 'aibox' desktop package..."
if pacman -Qi aibox >/dev/null 2>&1; then
    sudo pacman -Rns --noconfirm aibox
fi
rm -rf "$HOME/.cache/aibox"

echo "==> AIBox desktop application and App Launcher shortcut removed cleanly!"
echo ""
if [[ "${1:-}" == "--full" ]]; then
    echo "==> --full mode: Removing Incus service, UFW rules, and all containers..."
    if command -v ufw >/dev/null 2>&1 && systemctl is-active --quiet ufw; then
        sudo ufw delete allow in on incusbr0 >/dev/null 2>&1 || true
        sudo ufw route delete allow in on incusbr0 >/dev/null 2>&1 || true
        sudo ufw route delete allow out on incusbr0 >/dev/null 2>&1 || true
    fi
    sudo systemctl disable --now incus.service incus.socket 2>/dev/null || true
    sudo rm -rf /etc/systemd/system/incus.service.d
    sudo systemctl daemon-reload
    sudo pacman -Rns --noconfirm incus dnsmasq xorg-xhost 2>/dev/null || true
    sudo rm -rf /var/lib/incus
    echo "==> All Incus components and containers have been completely removed."
else
    echo "Note: Incus service and your created environments were kept intact."
    echo "To also remove Incus and all containers, run: ./bin/uninstall --full"
fi
