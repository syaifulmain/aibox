#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

find_cargo() {
    if cargo --version >/dev/null 2>&1; then
        command -v cargo
        return 0
    fi
    for candidate in /usr/bin/cargo "$HOME/.cargo/bin/cargo"; do
        if [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    echo "cargo not found (install rust or rustup)" >&2
    return 1
}

CARGO="$(find_cargo)"
"$CARGO" build --release --locked -p aibox-app --manifest-path "$ROOT/rust/Cargo.toml"

echo "Built $ROOT/rust/target/release/aibox"
