pkgname=aibox
pkgver=0.1.0
pkgrel=1
pkgdesc='Isolated Linux OS environment manager for AI, Desktop, and Mobile projects'
arch=('x86_64' 'aarch64')
license=('MIT')
options=('!debug')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'incus')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/aibox "$pkgdir/usr/bin/aibox"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/aibox.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/aibox.svg"
  install -Dm644 "$startdir/aibox.desktop" "$pkgdir/usr/share/applications/aibox.desktop"
}
